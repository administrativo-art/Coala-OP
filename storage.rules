rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars — qualquer usuário autenticado lê; o próprio usuário ou admin escreve
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (
          request.auth.uid == userId ||
          request.auth.token.isDefaultAdmin == true
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Documentos de despacho — leitura autenticada, escrita só para admins
    match /dispatch/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.isDefaultAdmin == true;
    }

    // Fotos de patrimônio — qualquer usuário autenticado lê e escreve
    match /assets/{assetId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Signage — uploads acontecem por rota server-side autenticada; arquivos são servidos por download token.
    match /signage/{allPaths=**} {
      allow read, write: if false;
    }

    // Qualquer outro arquivo — leitura autenticada, escrita negada por padrão
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
