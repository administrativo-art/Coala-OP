rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.get('isDefaultAdmin', false) == true;
    }

    // Avatars — qualquer usuário autenticado lê; o próprio usuário ou admin escreve
    match /avatars/{userId} {
      allow read: if isAuth();
      allow write: if isAuth()
        && (
          request.auth.uid == userId ||
          isAdmin()
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Uploads operacionais e de patrimônio acontecem somente por rotas server-side.
    match /dispatch/{allPaths=**} {
      allow read, write: if false;
    }

    match /assets/{allPaths=**} {
      allow read, write: if false;
    }

    // Signage — uploads acontecem por rota server-side autenticada; arquivos são servidos por download token.
    match /signage/{allPaths=**} {
      allow read, write: if false;
    }

    // Arquivos server-side são acessados somente por URLs com token específico.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
