rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /publishedPlayers/{kioskId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Marketing do Instagram — acesso somente pelas APIs e pelo job com Admin SDK.
    match /instagramScheduledPosts/{scheduleId} {
      allow read, write: if false;
    }

    match /instagramPosts/{postId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /instagramManualPublicationReminders/{reminderId} {
      allow read, write: if false;
    }

    match /instagramMediaLibrary/{mediaId} {
      allow read, write: if false;
    }

    match /instagramMediaFolders/{folderId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
