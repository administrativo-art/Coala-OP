# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code (local config; somente adaptadores compartilhados são versionados)
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/coala-issue-draft
!/.claude/skills/coala-handoff
!/.claude/skills/coala-resume-handoff
!/.claude/skills/coala-security-scan
!/.claude/skills/coala-supply-chain-audit
!/.claude/skills/coala-error-triage

# artefatos locais produzidos pelas Agent Skills
.ai-work/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
error.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
firebase-debug.log
firestore-debug.log

# service accounts (nunca commitar)
scripts/sa-*.json
scripts/*firebase-adminsdk*.json
scripts/dp-collaborator-mapping.json
scripts/dp-id-map.json
relatorios/

# Snapshots locais de dados de producao (nao versionar)
backups/

# Artefatos locais de renderização e conciliação (não versionar)
/output/inter/
/output/render/
/output/rendered/
/tmp/pdfs/
