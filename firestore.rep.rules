rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A ARP oficial nunca é acessada diretamente por clientes. Toda leitura e
    // escrita passa pelos serviços server-side autenticados e auditados.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
