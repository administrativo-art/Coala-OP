rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isAuth() {
      let cache = request.auth != null
        ? get(/databases/$(database)/documents/rh_access_cache/$(request.auth.uid)).data
        : {};
      return request.auth != null
          && cache.get('is_active', true) != false
          && cache.get('session_version', 0) == request.auth.token.get('sessionVersion', 0);
    }

    function isDefaultAdmin() {
      return isAuth() && request.auth.token.get('isDefaultAdmin', false) == true;
    }

    // Busca o cache de acesso RH do usuário logado.
    // rh_access_cache é mantido pela CF syncRhAccessCache — nunca escrito pelo cliente.
    function rhCache() {
      return get(/databases/$(database)/documents/rh_access_cache/$(request.auth.uid)).data;
    }

    function rhRole() {
      let cache = rhCache();
      return cache.get('rh_role', null);
    }

    function hasCurrentProfileCompliance() {
      let cache = rhCache();
      return isAuth()
          && cache.get('profile_compliance_status', 'pending') == 'complete'
          && cache.get('profile_compliance_policy_version', 0) == 1;
    }

    function isAdmin()   { return hasCurrentProfileCompliance() && (isDefaultAdmin() || rhRole() == 'admin'); }
    function isManager() { return hasCurrentProfileCompliance() && (isAdmin() || rhRole() == 'manager'); }
    function isEmployee() { return hasCurrentProfileCompliance() && (isManager() || rhRole() == 'employee'); }

    // Retorna true se o usuário logado é o próprio colaborador (via rh_access_cache)
    function isOwner(bizneoId) {
      return hasCurrentProfileCompliance() && rhCache().get('bizneo_employee_id', null) == bizneoId;
    }

    // Manager vê colaboradores da mesma unit_id
    function isSameUnit(employeeUnitId) {
      return hasCurrentProfileCompliance() && rhCache().get('unit_id', null) == employeeUnitId;
    }

    function canReadEmployee(bizneoId, employeeUnitId) {
      return isAdmin()
          || isOwner(bizneoId)
          || (isManager() && isSameUnit(employeeUnitId));
    }

    // Verifica visibilidade de um campo pelo field_map (coala-rh/schema/field_map)
    function fieldVisibility(fieldKey) {
      let fm = get(/databases/$(database)/documents/schema/field_map).data;
      return fm.fields.get(fieldKey, {}).get('visibility', 'confidential');
    }

    function canReadField(fieldKey, bizneoId) {
      let vis = fieldVisibility(fieldKey);
      return (vis == 'public' && isEmployee())
          || (vis == 'restricted_partial' && (isManager() || isOwner(bizneoId)))
          || (vis == 'restricted_total' && isManager())
          || (vis == 'confidential' && isAdmin())
          // Legado: permissões antigas salvas no field_map antes do modelo atual.
          || (vis == 'sensitive' && isManager())
          || (vis == 'internal' && isAdmin());
    }

    // ─── rh_access_cache ────────────────────────────────────────────────────
    // Cada usuário lê o próprio cache; admins leem qualquer um.
    // Somente a CF syncRhAccessCache escreve nesta coleção.
    match /rh_access_cache/{uid} {
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── employees ──────────────────────────────────────────────────────────
    match /employees/{bizneoId} {
      allow read:   if isAuth() && canReadEmployee(bizneoId, resource.data.get('unit_id', ''));
      allow create: if false;  // somente CF syncFromBizneo
      allow update: if false;  // somente CF syncFromBizneo / onFieldUpdate
      allow delete: if false;

      // field_values: visibilidade por campo via field_map
      match /field_values/{fieldKey} {
        allow read:   if isAuth()
                      && canReadEmployee(bizneoId, get(/databases/$(database)/documents/employees/$(bizneoId)).data.get('unit_id', ''))
                      && canReadField(fieldKey, bizneoId);
        allow create: if false;  // somente CF onFieldUpdate
        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── schema (field_map) ──────────────────────────────────────────────────
    // Qualquer usuário autenticado pode ler o schema (necessário para o frontend montar formulários).
    // Somente admins escrevem (via painel /rh/config/fields ou seed script).
    match /schema/{docId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    // ─── Catálogo interno de cargos, funções e departamentos ─────────────────
    // Os documentos contêm dados internos (incluindo faixas salariais).
    // Leitura direta fica limitada a RH/gestão; toda escrita passa pelas APIs,
    // que aplicam validação de schema, permissão e auditoria.
    match /jobRoles/{roleId} {
      allow read:   if isManager();
      allow write:  if false;
    }

    match /jobDepartments/{deptId} {
      allow read:   if isManager();
      allow write:  if false;
    }

    match /jobFunctions/{funcId} {
      allow read:   if isManager();
      allow write:  if false;
    }

    // ─── audit_log ──────────────────────────────────────────────────────────
    // Imutável: managers leem (filtrado por equipe no app), admins leem tudo.
    // Criação somente via CF onFieldUpdate.
    match /audit_log/{logId} {
      allow read:   if isAdmin()
                    || (
                      rhRole() == 'manager'
                      && hasCurrentProfileCompliance()
                      && resource.data.employee_id is string
                      && exists(
                        /databases/$(database)/documents/employees/$(resource.data.employee_id)
                      )
                      && isSameUnit(
                        get(
                          /databases/$(database)/documents/employees/$(resource.data.employee_id)
                        ).data.get('unit_id', '')
                      )
                    );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── automation_tasks ───────────────────────────────────────────────────
    match /automation_tasks/{taskId} {
      allow read:   if isAdmin();
      allow write:  if false;  // somente CFs
    }

    // Configurações operacionais das clínicas de ASO são acessadas somente
    // pelas APIs de formalização, que aplicam permissões e auditoria.
    match /asoClinicConfigs/{entityId} {
      allow read, write: if false;
      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // ─── sync_log ────────────────────────────────────────────────────────────
    match /sync_log/{logId} {
      allow read:   if isAdmin();
      allow write:  if false;  // somente CF syncFromBizneo
    }

    // Pedidos de ausência e seus artefatos são acessíveis apenas pelo Admin SDK.
    match /dp_absenceTypes/{id} { allow read, write: if false; }
    match /dp_absenceCatalogMigrations/{id} { allow read, write: if false; }
    match /dp_absenceRequests/{id} { allow read, write: if false; }
    match /dp_absencePreparations/{id} { allow read, write: if false; }
    match /dp_absenceOccurrences/{id} { allow read, write: if false; }
    match /dp_absenceAvailabilityShadow/{id} { allow read, write: if false; }
    match /dp_absenceShadowOperations/{id} { allow read, write: if false; }
    match /dp_absenceReversals/{id} { allow read, write: if false; }
    match /dp_absenceRevisions/{id} { allow read, write: if false; }
    match /dp_absenceDayReservations/{id} { allow read, write: if false; }
    match /dp_absenceBalances/{id} { allow read, write: if false; }
    match /dp_absenceOutbox/{id} { allow read, write: if false; }
    match /dp_absenceEvents/{id} { allow read, write: if false; }
    match /dp_absenceAudit/{id} { allow read, write: if false; }
    match /dp_absenceIdempotency/{id} { allow read, write: if false; }
    match /dp_absenceOperationalIntents/{id} { allow read, write: if false; }
    match /dp_absenceOperationalAudit/{id} { allow read, write: if false; }
    match /dp_absenceRetentionCases/{id} { allow read, write: if false; }
    match /dp_absenceRetentionAudit/{id} { allow read, write: if false; }
    match /dp_absenceRetentionOperations/{id} { allow read, write: if false; }
    match /dp_absenceRetentionExecutionReceipts/{id} { allow read, write: if false; }
    match /dp_absenceRetentionReconciliations/{id} { allow read, write: if false; }

    // Ensaio nominal e trilhas acessórias continuam no RH; a ARP oficial fica no coala-rep-p.
    match /repP_pilotHeads/{id} { allow read, write: if false; }
    match /repP_pilotMarkings/{id} { allow read, write: if false; }
    match /repP_pilotOfflinePermits/{id} { allow read, write: if false; }
    match /repP_offlineCycles/{id} { allow read, write: if false; }
    match /repP_offlineCycleHeads/{id} { allow read, write: if false; }
    match /repP_pilotClassificationEvents/{id} { allow read, write: if false; }
    match /repP_pilotDayGuards/{id} { allow read, write: if false; }
    match /repP_pilotAdjustmentRequests/{id} { allow read, write: if false; }
    match /dp_timeRecordingAccessAudit/{id} { allow read, write: if false; }
    match /dp_journeyLocationEvents/{id} { allow read, write: if false; }
    match /dp_journeyLocationSessions/{id} { allow read, write: if false; }
    match /dp_journeyLocationLeases/{id} { allow read, write: if false; }

    // Tratamento do ponto (PTRP): pedidos de ajuste e tratamentos só pelas APIs autenticadas; o original segue na ARP.
    match /ptrp_adjustmentRequests/{id} { allow read, write: if false; }
    match /ptrp_markingClassifications/{id} { allow read, write: if false; }
    match /ptrp_treatments/{id} { allow read, write: if false; }
    match /ptrp_competenceClosures/{id} {
      allow read, write: if false;
      match /{nested=**} { allow read, write: if false; }
    }
    match /dp_timeBankMovementGuards/{id} { allow read, write: if false; }
    match /dp_timeBankMovementOperations/{id} { allow read, write: if false; }

    // Recrutamento é acessado exclusivamente pelas APIs autenticadas.
    match /candidates/{id}   { allow read, write: if false; }
    match /applications/{id} { allow read, write: if false; }
    match /jobOpenings/{id}  { allow read, write: if false; }
  }
}
